# ============================================================================
# E-Syrians Web (Next.js) — environment template
# ============================================================================
#
# Copy this file to `.env.local` (gitignored) and fill in real values for
# local dev. Production values go into the hosting provider's env-vars UI
# (Vercel project settings, etc.) — never commit `.env.local`.
#
# Anything prefixed `NEXT_PUBLIC_*` is bundled into the browser JS and
# visible to anyone who views the page source. Never put server-only
# secrets behind that prefix.
# ============================================================================


# ----------------------------------------------------------------------------
# REQUIRED — App identity
# ----------------------------------------------------------------------------

# Bare host (no scheme, no trailing slash). Used in canonical URLs,
# Open Graph tags, etc.
# Production: www.e-syrians.com
# Local dev:  localhost:3000
NEXT_PUBLIC_DOMAIN_NAME=""

# Full URL with scheme. Used wherever we need an absolute URL for the
# frontend itself (sharing links, redirects, etc.).
# Production: https://www.e-syrians.com
# Local dev:  http://localhost:3000
NEXT_PUBLIC_DOMAIN_URL=""

# Server-side URL of the Laravel API the Next.js server actions call.
# NOT a NEXT_PUBLIC_ var — this stays server-side. The frontend never
# talks to the API directly; it goes through Next.js server actions
# which proxy and add auth.
# Production: https://api.e-syrians.com
# Local dev:  https://e-syrians-api.test
API_URL=""


# ----------------------------------------------------------------------------
# REQUIRED — Maps (Google Maps embed/picker)
# ----------------------------------------------------------------------------

# Google Cloud Console → APIs & Services → Credentials → API key. Enable
# the "Maps JavaScript API". Restrict the key to your domain
# (HTTP-referrer restriction) so it can't be reused by other sites.
# This IS bundled into the browser (NEXT_PUBLIC_), but Google's referrer
# restriction prevents abuse.
NEXT_PUBLIC_MAP_KEY=""


# ----------------------------------------------------------------------------
# REQUIRED — NextAuth (Auth.js) secrets
# ----------------------------------------------------------------------------

# Server-side JWT signing secret used by the API client to mint requests
# the Laravel side trusts. Generate with: `openssl rand -hex 32`.
JWT_SECRET=""

# NextAuth's own session-cookie signing secret. Generate with the same
# command. Rotate either secret and existing sessions invalidate.
AUTH_SECRET=""


# ----------------------------------------------------------------------------
# REQUIRED — Social sign-in (Google web flow)
# ----------------------------------------------------------------------------

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 client
# (WEB type). The redirect URI registered there must be exactly:
#   ${NEXT_PUBLIC_DOMAIN_URL}/api/auth/callback/google
# Both values are read by NextAuth at runtime.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""


# ----------------------------------------------------------------------------
# REQUIRED — Social sign-in (Apple web flow)
# ----------------------------------------------------------------------------

# Apple Sign In (web popup flow). The Services ID you registered in
# Apple Developer for this domain — different from the mobile bundle id.
# Must match APPLE_WEB_CLIENT_ID configured on the Laravel API side
# (the API verifies the audience claim against this value).
NEXT_PUBLIC_APPLE_CLIENT_ID=""


# ----------------------------------------------------------------------------
# REQUIRED — reCAPTCHA Enterprise (anti-spam on sensitive writes)
# ----------------------------------------------------------------------------

# Site key from Google Cloud Console → Security → reCAPTCHA Enterprise.
# Bundled into the browser (the JS challenge runs client-side). The
# resulting token gets POSTed to the API which verifies via the
# Assessments API server-side.
# Must match RECAPTCHA_SITE_KEY on the Laravel API side AND
# EXPO_PUBLIC_RECAPTCHA_SITE_KEY on mobile — same key across all three.
NEXT_PUBLIC_RECAPTCHA=""
# Note: RECAPTCHA_SECRET_KEY is configured on the Laravel API side only
# (services.recaptcha.api_key) — verification happens server-side via
# the Enterprise Assessments API, not from the browser.


# ----------------------------------------------------------------------------
# OPTIONAL — Stripe (donations)
# ----------------------------------------------------------------------------

# Stripe Dashboard → Developers → API keys.
# - PUBLISHABLE_KEY (pk_…) is bundled into the browser for Stripe.js.
# - SECRET_KEY (sk_…) is server-side only — used by the donation server
#   action to create PaymentIntents.
# Use test keys (pk_test_… / sk_test_…) for development.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
